ENV=development
LOG_LEVEL=INFO

# Postgres (production). Defaults to a local SQLite file if unset.
DATABASE_URL=postgresql+asyncpg://copilot:copilot@postgres:5432/agentic_copilot

# Redis cache. Falls back to an in-process cache automatically if unreachable.
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=1800

# OpenAI. Leave OPENAI_API_KEY unset (or USE_MOCK_LLM=true) to run the whole
# pipeline against the deterministic mock LLM — no key required.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
USE_MOCK_LLM=true

MAX_PLAN_STEPS=8
MAX_TOOL_RETRIES=2

CORS_ORIGINS=["http://localhost:3000"]
